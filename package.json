{
  "name": "browser-yt-dlp",
  "version": "0.1.0",
  "private": true,
  "description": "yt-dlp running entirely in the browser via WebAssembly (Pyodide + ffmpeg.wasm)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/dev-server.mjs",
    "build:firefox": "node scripts/build-extension.mjs",
    "serve": "node scripts/dev-server.mjs",
    "test": "node --test test/shim.test.mjs"
  },
  "devDependencies": {
    "@ffmpeg/core": "0.12.10",
    "pyodide": "314.0.7"
  },
  "engines": {
    "node": ">=20"
  }
}
